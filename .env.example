# Copy this file to .env and fill in the values.
# You can set one or both destinations — every notification is sent to all
# of them.

# WhatsApp number that will receive the notifications (usually your own),
# including the country code, e.g. +5215512345678
PHONE_TO_NOTIFY=
# Optional: also send notifications to a group (exact group name, you must
# be a member). Products with "tagEveryone": true will @-mention all group
# participants.
# NOTIFY_GROUP=Pokemon Hunters
