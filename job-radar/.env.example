# Copia este archivo a .env  (job-radar/.env)

# --- Notificaciones por WhatsApp (opcional, reusa tu cuenta de Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero sandbox de WhatsApp de Twilio, formato +14155238886
TWILIO_WHATSAPP_NUMBER=
# Tu numero, con codigo de pais. Ej: +521XXXXXXXXXX
PHONE_TO_NOTIFY=

# Avisar solo si el match es >= a esto (0-100)
NOTIFY_MIN_SCORE=70
# Maximo de vacantes por mensaje
NOTIFY_MAX_JOBS=5
